# 복사해서 .env 로 저장 후 채우세요

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voices 화면에서 쓸 목소리의 Voice ID
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# 말 속도 0.7~1.2 (숏폼은 1.05~1.15 추천)
ELEVENLABS_SPEED=1.1

# elevenlabs | edge (edge = 무료 미리보기용 MS 음성)
TTS_ENGINE=elevenlabs

# 구독 CLI (비우면 자동 탐색)
CLAUDE_PATH=
CLAUDE_MODEL=
CODEX_PATH=
CODEX_MODEL=gpt-6-luna
CODEX_EFFORT=medium

# 영상
TARGET_MIN_SEC=62
TARGET_MAX_SEC=86
# 가로 영상 확대 (클수록 양옆을 더 자르고 크게)
FG_ZOOM=1.5
# black(검은 여백) | blur(흐린 배경)
BG_STYLE=black
# 상단 제목 2줄 색 (pink | yellow | #RRGGBB), 나레이션 색
TITLE2_COLOR=pink
NARR_COLOR=yellow

# 공정 이용 가이드라인 (법적 기준이 아닌 내부 안전 기준)
NARR_RATIO_MIN=0.5
MAX_SOURCE_RATIO=0.10
MIN_ANALYSIS=2
