# 복사해서 .env 로 저장 후 채우세요

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voices 화면에서 쓸 목소리의 Voice ID
ELEVENLABS_VOICE_ID=
# eleven_v4_turbo(빠름, 기본) | eleven_v4 | eleven_v3 | eleven_multilingual_v2(구형)
ELEVENLABS_MODEL=eleven_v4_turbo
# 말 속도 0.7~1.2 (숏폼은 1.05~1.15 추천)
ELEVENLABS_SPEED=1.1

# 음성 엔진: elevenlabs | typecast | gemini | google | edge(무료 미리보기) | auto(되는 엔진 순서대로)
TTS_ENGINE=elevenlabs
# 아래 엔진들은 auto-insta 와 같은 목소리 목록을 쓴다 (대시보드에서 골라도 됨)
TYPECAST_API_KEY=
TYPECAST_VOICE=gangil          # seohyun(서현) | hanyoung(한영) | gangil(강일)
GEMINI_API_KEY=
GEMINI_VOICE=male              # female(Kore) | male(Charon)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=male          # female(Neural2-A) | male(Neural2-C)

# 구독 CLI (비우면 자동 탐색)
CLAUDE_PATH=
CLAUDE_MODEL=
CODEX_PATH=
CODEX_MODEL=gpt-6-luna
CODEX_EFFORT=medium

# 영상
TARGET_MIN_SEC=62
TARGET_MAX_SEC=86
# 템플릿: bold(굵은 제목 + 큰 화면, 기본) | classic(가운데 화면 + 위아래 여백)
TEMPLATE=bold
# bold: 제목 1줄/2줄/해설 자막 색 (neon=노랑, green=형광초록, pink, #RRGGBB)
BOLD_TITLE1=neon
BOLD_TITLE2=green
BOLD_NARR=neon
# bold: 최소 확대, 제목 아래 영역을 채울 비율, 확대 상한 (양옆은 얼굴 위치를 따라 자름)
BOLD_ZOOM=1.8
BOLD_FILL=0.75
BOLD_MAX_ZOOM=2.6
# 나레이션 중 원음 볼륨, 줄었다 커지는 시간(초)
NARR_ORIG_VOLUME=0.15
DUCK_FADE=0.35

# classic 템플릿 설정
FG_ZOOM=1.5
BG_STYLE=black
TITLE2_COLOR=pink
NARR_COLOR=yellow

# 공정 이용 가이드라인 (법적 기준이 아닌 내부 안전 기준)
# 나레이션 비중 70~80% = 원음 그대로 나오는 원본 구간 20~30%
NARR_RATIO_MIN=0.7
NARR_RATIO_MAX=0.8
MAX_SOURCE_RATIO=0.10
MIN_ANALYSIS=2
